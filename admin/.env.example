# Copy to .env.local for local work. In production every one of these lives in
# Vercel > the admin project > Settings > Environment Variables, and nowhere
# else. The repository is public.
#
# Written in the same shape as the main app's .env.example: what each one is
# for, and what happens without it, next to the variable rather than in a
# separate document.


# ------------------------------------------------------------------ browser --
# Both ship in the bundle, both are meant to. These are the same two values the
# main app uses, pointing at the same Supabase project.
#
# The publishable key is public by design. It is not what protects this
# dashboard. What protects it is that every function the page calls checks
# admin.allowlist inside Postgres before it returns anything, so a stranger
# holding this key and signed in with their own account gets a refusal. See the
# header of admin/supabase/migrations/A001_admin_schema.sql.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ------------------------------------------------------- the daily job only --
# None of these has a VITE_ prefix, on purpose. Vite only puts VITE_ variables
# into the browser bundle, and every one below is a password.


# How the job reaches Postgres. Preferred route.
#
# A Supabase personal access token, from Account > Access Tokens. Starts sbp_.
# It has no scopes to choose and it reaches every project on the account, so it
# is the most powerful credential in this file by a distance. It is here rather
# than a service_role key because a service_role key bypasses every policy in
# 0001..0009, and one all-powerful secret is better than two.
#
# The project ref is the subdomain in the Supabase dashboard URL.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=

# Fallback route, used only when the token above is not set.
#
# Needs `admin` added to Settings > API > Exposed schemas. That is safe: A001
# revokes schema usage from anon and authenticated, so exposing it tells
# PostgREST it may route there without granting anyone anything. Delete these
# two once the Management API route is confirmed working on the free plan.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=


# Crashes. An organization auth token from Sentry > Settings > Auth Tokens,
# scoped org:read, project:read and event:read.
#
# Absent, the Crashes panel shows dashes and the run notes say why. Nothing else
# is affected: the job records the note and carries on.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=


# Counting emails, and sending the two alerts.
#
# Must be a Full access key. A Sending access key cannot list emails, and
# listing is how the daily and monthly counts are worked out. That also means
# this key can read the body of a sent message, including a sign-in code, so it
# belongs in Vercel and never in a file.
#
# Absent, the email quotas show as never captured and no alert can be sent.
RESEND_API_KEY=

# Both optional. The defaults are the ones to run with, and the from address has
# to sit on a domain verified in Resend, which pbroundrobin.com already is.
ALERT_TO=jeff@positivefutures.com
ALERT_FROM=jeff@positivefutures.com


# The shared secret Vercel Cron sends as `Authorization: Bearer <secret>`.
#
# Set it to any long random string; `openssl rand -hex 32` is fine. Without it
# /api/snapshot refuses every request rather than defaulting to open, because
# pressing that endpoint costs Resend allowance and Sentry API calls.
CRON_SECRET=


# ---------------------------------------------------------------- tests only --
# Set by hand when running the end to end test. ./scripts/scratch-db.sh builds
# the database and prints the value. Never point this at the live project.
ADMIN_TEST_PG=
