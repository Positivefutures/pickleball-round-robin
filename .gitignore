# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Trailing * so copies like node_modules_OLD_BACKUP are covered too — a bare
# "node_modules" matches only that exact name, and a stray 147MB copy would
# otherwise be one `git add -A` away from being committed permanently.
node_modules*
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vercel
